# Copy to .env and fill in locally. Never commit .env.
# Phase 0 reads none of these yet; they reserve names for later phases.

# Runtime environment: dev | test | prod
MABHAS19_ENV=dev

# Alternative config file (defaults to configs/default.yaml)
# MABHAS19_CONFIG=configs/default.yaml

# Provider credentials (only needed for API-based providers, added in later phases)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Gemini (Phase 2B benchmark only). Values in .env override OS environment variables.
# GEMINI_API_KEY=
